# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Telegram ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=123456789

# Ключ Claude API (https://platform.claude.com). Если не задан,
# бот работает на fallback-интерпретациях из значений карт.
ANTHROPIC_API_KEY=
# Модель для интерпретаций
LLM_MODEL=claude-opus-4-8

# Часовой пояс для «карты дня»
TZ=Europe/Moscow

# Контакт поддержки для /paysupport
SUPPORT_CONTACT=@your_support

# Цены в Telegram Stars (можно не трогать)
PRICE_ONE=15
PRICE_THREE=30
PRICE_RELATIONSHIP=45
PRICE_CELTIC=75
PRICE_CLARIFY=8
FREE_CLARIFICATIONS=2
